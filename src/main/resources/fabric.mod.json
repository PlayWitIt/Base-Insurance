{
	"schemaVersion": 1,
	"id": "baseinsurance",
	"version": "${version}",
	"name": "Base Insurance",
	"description": "Snapshots your bases and tells you exactly what changed while you were away: broken blocks, raided chests, nearby players. Shows the damage in-world and helps you rebuild. Client-side only.",
	"authors": [
		"PlayWit Creations"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"com.greysworkshop.baseinsurance.PanelData"
		],
		"client": [
			"com.greysworkshop.baseinsurance.BaseInsuranceClient"
		],
		"modmenu": [
			"com.greysworkshop.baseinsurance.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"hoardeye": "*"
	},
	"icon": "assets/baseinsurance/icon.png"
}
